      "id": "c9100000-0000-4000-8000-000000000006",
      "name": "Ler Efeito",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        -60
      ],
      "parameters": {
        "jsCode": "const bruto = String($input.first().json.resposta || '');\nconst falha = { aiMode: '', resposta: 'Não consegui aplicar o efeito. Nada foi alterado.', erro: true };\nif (!bruto.startsWith('@efeito ')) return [{ json: falha }];\nconst quebra = bruto.indexOf('\\n');\nconst cabeca = bruto.slice(8, quebra < 0 ? bruto.length : quebra);\nconst texto = quebra < 0 ? '' : bruto.slice(quebra + 1).trim();\nlet o;\ntry { o = JSON.parse(cabeca); } catch (e) { return [{ json: falha }]; }\nif (!o || o.tipo !== 'modo' || !['active', 'paused'].includes(o.aiMode)) return [{ json: falha }];\nreturn [{ json: { aiMode: o.aiMode, resposta: texto, erro: false } }];"
      }
    }
  },
