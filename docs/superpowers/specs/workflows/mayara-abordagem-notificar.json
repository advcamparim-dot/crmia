      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "jsCode": "const linhas = $input.all().map((i) => i.json);\nreturn linhas.map((r) => {\n  const nome = r.nome || 'Sem nome';\n  const texto = r.tipo === 'lembrete'\n    ? 'Lembrete: a proposta #' + r.id + ' (' + nome + ', final ' + r.telefone_fim + ') ainda aguarda sua resposta.\\n\\nResponda *sim ' + r.id + '* para enviar ou *não ' + r.id + '* para descartar.'\n    : 'Novo lead: ' + nome + ' (final ' + r.telefone_fim + ').\\n\\nA Mayara propõe enviar:\\n\\n' + r.texto + '\\n\\nResponda *sim ' + r.id + '* para enviar, *não ' + r.id + '* para descartar ou *editar ' + r.id + ': novo texto* para trocar a mensagem.';\n  return { json: { id: r.id, tipo: r.tipo, admin: r.admin, texto } };\n});"
      }
