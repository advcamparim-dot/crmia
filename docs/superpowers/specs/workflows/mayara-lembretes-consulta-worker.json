    {
      "id": "58276f7d-d13a-4916-90a3-fbc0e084af21",
      "name": "Buscar e Reservar Lembretes",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        440,
        0
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "operation": "executeQuery",
        "query": "with elegivel as (\n  select session_key,\n    case\n      when now() >= consulta_agendada_em - interval '15 minutes' and lembrete_consulta_estagio <> '15min' then '15min'\n      when now() >= consulta_agendada_em - interval '1 hour' and lembrete_consulta_estagio not in ('1h', '15min') then '1h'\n      when now() >= consulta_agendada_em - interval '1 day' and lembrete_consulta_estagio = 'nenhum' then '1dia'\n      else null\n    end as proximo_estagio\n  from mayara.session_state\n  where estado = 'S6_AGENDADO'\n    and follow_up_status not in ('excluido_seguranca')\n    and consulta_agendada_em is not null\n    and consulta_agendada_em > now()\n    and lembrete_consulta_estagio <> '15min'\n    and mayara.lead_ativo_da_sessao(session_key)\n  for update skip locked\n)\nupdate mayara.session_state s\nset lembrete_consulta_estagio = e.proximo_estagio,\n    follow_up_status = case when e.proximo_estagio = '15min' then 'transferido_consulta' else s.follow_up_status end\nfrom elegivel e\nwhere s.session_key = e.session_key\n  and e.proximo_estagio is not null\nreturning s.session_key, s.phone, s.phone_number_id, s.estado, s.fatos_json::text as \"fatosJson\", s.consulta_agendada_em, e.proximo_estagio;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "nNpCUIhnDuVvTApU",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "5cd7f4c9-0198-4611-a2da-538bec9fdeed",
      "name": "Reserva Valida?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.session_key }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              },
              "id": "v1"
            },
            {
              "leftValue": "={{ $json.phone }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              },
              "id": "v2"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "bc2baea8-08f4-4758-b69b-1002a7c7c6c1",
      "name": "Montar Template do Lembrete",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\nconst out = [];\nfor (const entry of items) {\n  const item = entry.json;\n  const fatos = JSON.parse(item.fatosJson || '{}');\n  const nome = (fatos.nomeCompleto || fatos.nomeLead || fatos.nome || '').split(' ')[0] || 'tudo bem';\n  const dataHora = new Date(item.consulta_agendada_em).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo', dateStyle: 'short', timeStyle: 'short' });\n  const horaCurta = new Date(item.consulta_agendada_em).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo', hour: '2-digit', minute: '2-digit' });\n\n  const templates = {\n    '1dia': { nome: 'lembrete_consulta_1dia', variaveis: [nome, dataHora, horaCurta] },\n    '1h':   { nome: 'lembrete_consulta_1hora', variaveis: [nome, horaCurta] },\n    '15min':{ nome: 'lembrete_consulta_transferencia', variaveis: [nome] }\n  };\n\n  const escolhido = templates[item.proximo_estagio];\n  if (!escolhido) {\n    out.push({ json: { ...item, templateValido: false } });\n  } else {\n    out.push({ json: { ...item, templateValido: true, templateNome: escolhido.nome, templateVariaveis: escolhido.variaveis } });\n  }\n}\nreturn out;"
      }
    },
    {
      "id": "d88c70d6-ae0a-4320-9d7d-4178cd79cacb",
      "name": "Template Valido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
