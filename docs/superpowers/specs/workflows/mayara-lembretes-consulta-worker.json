    {
      "id": "c341a476-a291-4563-88ef-e459e1235457",
      "name": "Segredo de Teste OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        220,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.headers['x-test-secret'] }}",
              "rightValue": "<SEGREDO_DE_TESTE>",
              "operator": {
