      "parameters": {
        "jsCode": "const itens = $input.all().map(i => i.json).filter(j => j && j.mensagem);\nitens.sort((a, b) => new Date(a.recebido_em) - new Date(b.recebido_em));\nconst combinada = itens.map(i => i.mensagem).join('\\n');\n\nreturn [{\n  json: {\n    ...$('Entrada').item.json,\n    mensagemCombinada: combinada || $('Entrada').item.json.message\n  }\n}];"
