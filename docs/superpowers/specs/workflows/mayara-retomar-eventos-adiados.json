      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select id, payload from mayara.reservar_eventos_adiados(now(), 10)",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "nNpCUIhnDuVvTApU",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "cf000000-0000-4000-8000-000000000003",
      "name": "Montar Eventos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "jsCode": "return $input.all().map((i) => ({ json: i.json.payload }));"
      }
    },
    {
      "id": "cf000000-0000-4000-8000-000000000004",
      "name": "Reenviar",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "onError": "continueRegularOutput",
      "position": [
        660,
        300
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "1ciEX4HqgbaS3Gqx",
          "mode": "list",
          "cachedResultName": "Mayara — Canal: Processar Evento [Sub-workflow]"
        },
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "cf000000-0000-4000-8000-000000000005",
      "name": "Casar Retorno",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "jsCode": "const reservados = $('Reservar').all();\nreturn $input.all().map((it, i) => ({ json: { id: reservados[i].json.id, falhou: Boolean(it.json && it.json.error), erro: String((it.json && it.json.error && (it.json.error.message || it.json.error)) || '').slice(0, 200) } }));"
      }
    },
    {
      "id": "cf000000-0000-4000-8000-000000000006",
      "name": "Falhou?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cf-falhou",
              "leftValue": "={{ $json.falhou === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "cf000000-0000-4000-8000-000000000007",
      "name": "Reabrir",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "onError": "continueRegularOutput",
      "position": [
        1320,
        200
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select mayara.reabrir_evento_adiado($1::bigint, $2)",
        "options": {
          "queryReplacement": "={{ [$json.id, $json.erro] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "nNpCUIhnDuVvTApU",
          "name": "Postgres account"
        }
      }
    }
