{
  "name": "Mayara — Retry CRM Falhas [Worker]",
  "nodes": [
    {
      "id": "d1000000-0000-4000-8000-000000000001",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "d1000000-0000-4000-8000-000000000002",
      "name": "Ler Fila de Retry",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        250,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select * from pgmq.read('mayara_crm_retry', 60, 10);",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "nNpCUIhnDuVvTApU",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "d1000000-0000-4000-8000-000000000003",
      "name": "Tentar Persistir de Novo",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        500,
        0
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "mode": "each",
        "workflowId": {
          "__rl": true,
          "value": "vf3iq6V7ztgsQS8G",
          "mode": "list",
          "cachedResultName": "Mayara — Persistir Consulta no CRM [Sub-workflow]"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "sessionKey": "={{ $json.message.sessionKey }}",
            "nome": "={{ $json.message.nome }}",
            "telefone": "={{ $json.message.telefone }}",
            "email": "={{ $json.message.email }}",
            "empresa": "={{ $json.message.empresa }}",
            "descricaoLead": "={{ $json.message.descricaoLead }}",
            "eventoCalendarioId": "={{ $json.message.eventoCalendarioId }}",
            "horarioInicio": "={{ $json.message.horarioInicio }}",
            "horarioFim": "={{ $json.message.horarioFim }}",
            "isRetry": true
          },
          "matchingColumns": []
        },
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "d1000000-0000-4000-8000-000000000004",
      "name": "Sucesso?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        750,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.success }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      }
    },
    {
      "id": "d1000000-0000-4000-8000-000000000005",
      "name": "Apagar da Fila",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1000,
        -100
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select pgmq.delete('mayara_crm_retry', $1::bigint);",
        "options": {
          "queryReplacement": "={{ $('Ler Fila de Retry').itemMatching($itemIndex).json.msg_id }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "nNpCUIhnDuVvTApU",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "d1000000-0000-4000-8000-000000000006",
      "name": "Excedeu Tentativas?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1000,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $('Ler Fila de Retry').item.json.read_ct }}",
              "rightValue": 5,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ]
        }
      }
    },
    {
      "id": "d1000000-0000-4000-8000-000000000007",
      "name": "Registrar Falha Permanente",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1250,
        100
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "insert into mayara.crm_retry_failed (payload, motivo_falha, tentativas) values ($1::jsonb, $2, $3);",
        "options": {
          "queryReplacement": "={{ [JSON.stringify($('Ler Fila de Retry').item.json.message), 'Falhou apos multiplas tentativas de retry (ver execucoes do sub-workflow para detalhes)', $('Ler Fila de Retry').item.json.read_ct] }}",
          "queryBatching": "independently"
        }
      },
      "credentials": {
        "postgres": {
          "id": "nNpCUIhnDuVvTApU",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "d1000000-0000-4000-8000-000000000008",
      "name": "Arquivar na Fila",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1500,
        100
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select pgmq.archive('mayara_crm_retry', $1::bigint);",
        "options": {
          "queryReplacement": "={{ $('Ler Fila de Retry').itemMatching($itemIndex).json.msg_id }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "nNpCUIhnDuVvTApU",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "d1000000-0000-4000-8000-000000000009",
      "name": "Avisar Falha Permanente",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        1750,
        100
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "FWSC1k1CBMWBtsNs",
          "mode": "list",
          "cachedResultName": "Mayara — Alertar Escritório [Sub-workflow]"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "texto": "={{ 'Atenção: um registro de consulta não conseguiu ser gravado no CRM após várias tentativas (' + ($('Ler Fila de Retry').item.json.message.nome || 'sem nome') + ', ' + ($('Ler Fila de Retry').item.json.message.telefone || 'sem telefone') + '). Confira e lance manualmente no CRM.' }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "texto",
              "displayName": "texto",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "options": {
          "waitForSubWorkflow": false
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Ler Fila de Retry",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ler Fila de Retry": {
      "main": [
        [
          {
            "node": "Tentar Persistir de Novo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tentar Persistir de Novo": {
      "main": [
        [
          {
            "node": "Sucesso?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sucesso?": {
      "main": [
        [
          {
            "node": "Apagar da Fila",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Excedeu Tentativas?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Excedeu Tentativas?": {
      "main": [
        [
          {
            "node": "Registrar Falha Permanente",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Registrar Falha Permanente": {
      "main": [
        [
          {
            "node": "Arquivar na Fila",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Arquivar na Fila": {
      "main": [
        [
          {
            "node": "Avisar Falha Permanente",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner"
  }
}
