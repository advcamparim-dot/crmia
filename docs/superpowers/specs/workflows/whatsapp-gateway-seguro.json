      "id": "1dacca52-36f8-4c7f-8faf-8251bcb1830f",
      "name": "Meta - Receber Eventos",
      "webhookId": "whatsapp-mayara-eventos"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst body = input.body || {};\nconst value = body.entry?.[0]?.changes?.[0]?.value || {};\nconst message = value.messages?.[0] || null;\nconst contact = value.contacts?.[0] || {};\nconst metadata = value.metadata || {};\n\nif (!message) {\n  return [{ json: { accepted: false, reason: 'EVENTO_SEM_MENSAGEM', eventType: value.statuses?.length ? 'status' : 'unknown' } }];\n}\n\nconst digits = String(message.from || '').replace(/\\D/g, '');\nconst phone = digits ? `+${digits}` : '';\nconst type = String(message.type || 'unknown');\nconst text = String(\n  message.text?.body ||\n  message.button?.text ||\n  message.interactive?.button_reply?.title ||\n  message.interactive?.list_reply?.title ||\n  ''\n).trim();\nconst referral = message.referral || value.referral || null;\n\nconst approvedReferralSourceIds = ['CONFIGURAR_ID_CAMPANHA'];\nconst allowedTestNumbers = ['<TELEFONE_DE_TESTE>'];\nconst referralSourceId = String(referral?.source_id || '');\nconst authorizedByCampaign = referralSourceId.length > 0 && approvedReferralSourceIds.includes(referralSourceId);\nconst authorizedForTest = allowedTestNumbers.includes(phone);\nconst supportedType = ['text', 'interactive', 'button'].includes(type);\nconst accepted = Boolean(phone && message.id && text && supportedType && (authorizedByCampaign || authorizedForTest));\n\nlet reason = 'ACEITO';\nif (!supportedType) reason = 'TIPO_REQUER_HUMANO';\nelse if (!phone || !message.id || !text) reason = 'PAYLOAD_INCOMPLETO';\nelse if (!authorizedByCampaign && !authorizedForTest) reason = 'FORA_DO_ESCOPO_CONTROLADO';\n\nreturn [{ json: {\n  accepted,\n  reason,\n  channel: 'WhatsApp',\n  phone,\n  profileName: String(contact.profile?.name || ''),\n  message: text,\n  messageType: type,\n  messageId: String(message.id || ''),\n  timestamp: message.timestamp ? new Date(Number(message.timestamp) * 1000).toISOString() : new Date().toISOString(),\n  phoneNumberId: String(metadata.phone_number_id || ''),\n  displayPhoneNumber: String(metadata.display_phone_number || ''),\n  sessionKey: phone ? `whatsapp:${String(metadata.phone_number_id || 'unknown')}:${phone}` : '',\n  dedupeKey: String(message.id || ''),\n  campaignSourceId: referralSourceId,\n  campaignSourceUrl: String(referral?.source_url || ''),\n  campaignHeadline: String(referral?.headline || ''),\n  requiresHuman: !supportedType,\n  processingBlocked: true\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
