    },
    {
      "parameters": {
        "jsCode": "const q = $input.first().json.query || {};\nconst mode = String(q['hub.mode'] || '');\nconst token = String(q['hub.verify_token'] || '');\nconst challenge = String(q['hub.challenge'] || '');\nconst configuredToken = '<VERIFY_TOKEN>';\nconst valid = mode === 'subscribe' && token === configuredToken && challenge.length > 0;\nreturn [{ json: { valid, challenge: valid ? challenge : 'Verificacao recusada', statusCode: valid ? 200 : 403 } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
