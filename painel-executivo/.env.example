# Connection string for the Supabase Postgres database (session pooler recommended).
SUPABASE_DB_URL=postgresql://user:password@host:port/database

# Shared password for the single-user login.
PAINEL_SENHA=

# Nao e mais usada: as sessoes agora ficam no banco (painel.sessoes) e sao revogaveis. Pode ser removida do Coolify.
SESSION_SECRET=
